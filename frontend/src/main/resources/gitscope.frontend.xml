<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="gitscope.shared"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <projectService serviceImplementation="gitscope.frontend.GutterRenderingService"/>
        <projectService serviceImplementation="rpc.FrontendGutterSubscriptions"/>
        <projectService serviceImplementation="rpc.FrontendUtilSubscriptions"/>
        <projectService serviceImplementation="rpc.FrontendTabStateService"/>
        <projectService serviceImplementation="gitscope.frontend.actions.ChangeNavCoroutineScopeHolder"/>
        <postStartupActivity implementation="gitscope.frontend.GutterRenderingStartup"/>
        <postStartupActivity implementation="rpc.FrontendGutterSubscriptionsStartup"/>
        <postStartupActivity implementation="rpc.FrontendUtilSubscriptionsStartup"/>
        <postStartupActivity implementation="rpc.FrontendTabStateStartup"/>
    </extensions>

    <actions>
        <action id="GitScope.NextChange"
                class="gitscope.frontend.actions.NextChangeAction"
                text="Next Change"
                description="Move to the next Git Scope change; wraps to the next changed file at the end of a file"/>
        <action id="GitScope.PreviousChange"
                class="gitscope.frontend.actions.PreviousChangeAction"
                text="Previous Change"
                description="Move to the previous Git Scope change; wraps to the previous changed file at the start of a file"/>
        <action id="GitScope.NextChangedFile"
                class="gitscope.frontend.actions.NextChangedFileAction"
                text="Next Changed File"
                description="Cycle to the first change of the next changed file"/>
        <action id="GitScope.PreviousChangedFile"
                class="gitscope.frontend.actions.PreviousChangedFileAction"
                text="Previous Changed File"
                description="Cycle to the first change of the previous changed file"/>
        <action id="GitScope.ShowDiff"
                class="gitscope.frontend.actions.ShowDiffAction"
                text="Show Diff"
                description="Show the Git Scope diff for the current file in an editor tab"/>

        <!-- Tab context menu. In split mode the tab strip is rendered by the frontend, so its
             context menu is built from this registry and the backend copies never appear; these
             hide themselves in monolith, where the backend actions are shown instead. -->
        <action id="GitScope.Frontend.MoveTabLeft"
                class="gitscope.frontend.actions.FrontendMoveTabLeftAction" text="Move Tab Left">
            <add-to-group group-id="ToolWindowContextMenu" anchor="first"/>
        </action>
        <action id="GitScope.Frontend.MoveTabRight"
                class="gitscope.frontend.actions.FrontendMoveTabRightAction" text="Move Tab Right">
            <add-to-group group-id="ToolWindowContextMenu" anchor="after"
                          relative-to-action="GitScope.Frontend.MoveTabLeft"/>
        </action>
        <action id="GitScope.Frontend.RenameTab"
                class="gitscope.frontend.actions.FrontendRenameTabAction" text="Rename Tab">
            <add-to-group group-id="ToolWindowContextMenu" anchor="after"
                          relative-to-action="GitScope.Frontend.MoveTabRight"/>
        </action>
        <action id="GitScope.Frontend.ResetTabName"
                class="gitscope.frontend.actions.FrontendResetTabNameAction" text="Reset Tab Name">
            <add-to-group group-id="ToolWindowContextMenu" anchor="after"
                          relative-to-action="GitScope.Frontend.RenameTab"/>
        </action>
    </actions>
</idea-plugin>
